<%# Avatar Sizes %>
<div class="flex gap-4 items-end">
  <% [8, 12, 16, 20, 24, 32].each do |size| %>
    <%= render(DaisyComponents::DataDisplay::AvatarComponent.new(
      size: size,
      img_src: 'https://placehold.co/400x400/3B82F6/FFFFFF?text=A',
      img_alt: "Avatar size #{size}"
    )) %>
  <% end %>
</div>

<%# Extra Small %>
<%= render(DaisyComponents::DataDisplay::AvatarComponent.new(
  size: :xs,
  img_src: 'https://placehold.co/400x400/3B82F6/FFFFFF?text=XS',
  img_alt: 'Extra Small Avatar'
)) %>

