<%# Avatar Shapes %>
<div class="flex gap-4">
  <% [:circle, :squircle, :hexagon, :triangle, :half_1, :half_2].each do |shape| %>
    <%= render(DaisyComponents::DataDisplay::AvatarComponent.new(
      shape: shape,
      size: :md,
      img_src: 'https://placehold.co/400x400/3B82F6/FFFFFF?text=A',
      img_alt: "Avatar shape #{shape}"
    )) %>
  <% end %>
</div>

<%# Circle %>
<%= render(DaisyComponents::DataDisplay::AvatarComponent.new(
  shape: :circle,
  img_src: 'https://placehold.co/400x400/3B82F6/FFFFFF?text=CI',
  img_alt: 'Circle Avatar'
)) %>

