<%= render DaisyComponents::Actions::ButtonComponent.new(tag_type: :a, href: "#") %>
<%= render DaisyComponents::Actions::ButtonComponent.new(text: "Button") %>
<%= render DaisyComponents::Actions::ButtonComponent.new(tag_type: :input, value: "Input") %>
<%= render DaisyComponents::Actions::ButtonComponent.new(tag_type: :input, value: "Submit", type: :submit) %>
<%= render DaisyComponents::Actions::ButtonComponent.new(tag_type: :input, value: "Radio", type: :radio, **{"aria-label": "Radio"}) %>
<%= render DaisyComponents::Actions::ButtonComponent.new(tag_type: :input, value: "Checkbox", type: :checkbox, **{"aria-label": "Checkbox"}) %>
<%= render DaisyComponents::Actions::ButtonComponent.new(tag_type: :input, value: "Reset", type: :reset) %> 