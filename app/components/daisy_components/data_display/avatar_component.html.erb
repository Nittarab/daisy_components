<%# Avatar Group %>
<% if group.any? %>
  <%= tag.div(**html_attributes) do %>
    <% group.each do |avatar| %>
      <%= render(avatar) %>
    <% end %>
  <% end %>
<% else %>
  <%= render(DaisyComponents::DataDisplay::AvatarItemComponent.new(
    size: size,
    **system_arguments
  )) %>
<% end %> 
